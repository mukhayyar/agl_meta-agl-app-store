[Unit]
Description=Refocus the AGL PENS App Store after another application terminates
After=agl-compositor.service
Wants=agl-compositor.service

[Service]
Type=simple
ExecStart=/usr/bin/agl-store-refocus

# The watcher must outlive anything the compositor does, so keep restarting it.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
