// ============================================================
// 50-agl-flatpak.rules — polkit rule for the AGL PENS App Store
// ============================================================
// flatpak performs system-wide operations (install/update/uninstall,
// remote configuration) through flatpak-system-helper over D-Bus, and
// authorises them via polkit. On the IVI target the App Store runs from a
// systemd unit with no session, so there is no polkit agent that could ask
// for a password: every install fails with
//
//     error: Failed to install ...: not authorized
//
// Allow the AGL application user (and root) to perform the Flatpak
// system-helper actions without an interactive prompt. Scope is limited to
// the org.freedesktop.Flatpak.* action namespace -- nothing else on the
// system is affected.
// ============================================================

polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.Flatpak.") !== 0) {
        return polkit.Result.NOT_HANDLED;
    }

    if (subject.user === "root" ||
        subject.user === "agl-driver" ||
        subject.isInGroup("agl-driver")) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
